# ==========================================
# 1. CORE R & RSTUDIO CONTROLS (From gitignore.io)
# ==========================================
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Rproj.user/
*-Ex.R
/*.tar.gz
/*.Rcheck/
.httr-oauth
*_cache/
/cache/
*.utf8.md
*.knit.md
.Renviron

# ==========================================
# 2. OPERATING SYSTEM TRASH (Mac & Windows)
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db

# ==========================================
# 3. PSYCHOLOGY RESEARCH DATA PROTECTION 
# ==========================================
# Strictly prevents accidental leaks of participant data
*.csv
*.xlsx
*.xls
*.sav
*.dta
*.rds

# ==========================================
# 4. MANUSCRIPT & OUTPUT GENERATION
# ==========================================
# Keeps final compiled papers out of the code repo
*.html
*.pdf
*.docx
